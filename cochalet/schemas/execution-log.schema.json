{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hermes Execution Log Entry",
  "type": "object",
  "required": [
    "timestamp",
    "skill",
    "model",
    "duration_seconds",
    "output_file",
    "pipeline_stage"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "skill": {
      "type": "string",
      "enum": [
        "content-strategy",
        "copywriting",
        "email-sequence",
        "social-content",
        "ad-creative",
        "sales-enablement",
        "marketing-ideas",
        "product-marketing-context",
        "seo-audit",
        "ai-seo",
        "page-cro",
        "copy-editing",
        "cold-email",
        "community-marketing",
        "ab-test-setup",
        "competitor-alternatives",
        "launch-strategy",
        "marketing-psychology",
        "customer-research",
        "referral-program",
        "lead-magnets",
        "signup-flow-cro",
        "onboarding-cro",
        "site-architecture",
        "schema-markup",
        "paid-ads",
        "analytics-tracking",
        "pricing-strategy",
        "revops",
        "free-tool-strategy",
        "programmatic-seo",
        "form-cro",
        "popup-cro",
        "churn-prevention"
      ]
    },
    "tier": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "wave": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "model": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "estimated_cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "task": {
      "type": "string"
    },
    "output_file": {
      "type": "string"
    },
    "output_word_count": {
      "type": "integer",
      "minimum": 0
    },
    "pipeline_stage": {
      "type": "string",
      "enum": [
        "GATE_CHECK",
        "STAGING",
        "VERIFY",
        "PRODUCTION"
      ]
    },
    "four_nevers_self_check": {
      "type": "boolean"
    },
    "canon_prepended": {
      "type": "boolean"
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
