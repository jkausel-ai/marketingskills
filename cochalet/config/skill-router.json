    "self_routing_logic": {
        "description": "Hermes reads this file at task start. Matches task keywords against skill triggers to select model.",
        "algorithm": [
            "1. RECEIVE task description from COS or Telegram",
            "2. MATCH task keywords against skills[].cochalet_context + routing_rules.escalation_triggers",
            "3. SELECT model: if escalation_trigger matched → sonnet-hermes; if speed_trigger → qwen; if ideation_trigger → gemma-4; if extraction_trigger → gemini-flash; else → gpt-oss-120b (default)",
            "4. PREPEND Canon context from HERMES_KNOWLEDGE_BASE.md (first 80 lines)",
            "5. EXECUTE task with selected model",
            "6. VERIFY output: check Four Nevers compliance, check brand voice, check factual accuracy",
            "7. IF quality < 7/10 → escalate to sonnet-hermes for revision",
            "8. SAVE output to deliverables/ with model suffix (e.g., -GPTOSS.md, -SONNET.md)",
            "9. LOG model used, tokens consumed, quality score to memory/iterations/"
        ],
        "cost_ceiling_daily": 0.5,
        "token_budget_per_task": 4000,
        "canon_context_tokens": 800
    },
